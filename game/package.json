{
  "name": "@quantum-billing/catch-davel-game",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "content:schema": "node scripts/generate-level-schema.mjs",
    "content:schema:check": "node scripts/generate-level-schema.mjs --check",
    "content:export": "node scripts/export-level-content.mjs",
    "content:export:check": "node scripts/export-level-content.mjs --check",
    "content:submission": "node scripts/validate-content-submission.mjs",
    "authoring:dry-run": "node scripts/run-authoring-dry-run.mjs",
    "build": "npm run content:schema:check && npm run content:export:check && tsc --noEmit && vite build",
    "format:check": "node scripts/check-format.mjs",
    "lint": "tsc --noEmit && node scripts/lint-source.mjs",
    "test": "vitest run",
    "qa:campaign": "vitest run test/campaign-qa.test.ts --reporter=verbose",
    "qa:balance": "vitest run test/balance-harness.test.ts --reporter=verbose",
    "test:worker": "node scripts/verify-worker.mjs",
    "test:runtime": "vite build && node scripts/verify-live-runtime.mjs && node scripts/verify-production-runtime.mjs",
    "release:evidence": "node scripts/create-release-evidence.mjs",
    "release:evidence:test": "node scripts/test-release-evidence.mjs",
    "tauri:dev": "tauri dev",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri:build:binary": "tauri build --no-bundle",
    "tauri:build": "tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.2.0",
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  }
}
